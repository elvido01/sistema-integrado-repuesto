{
  "name": "motoflow-print-agent",
  "version": "0.7.0",
  "description": "Agente local de impresión para Motoflow — reemplaza QZ Tray",
  "private": true,
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build": "pkg . --target node18-win-x64 --output dist/motoflow-print-agent.exe"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "lib/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "author": "Motoflow",
  "license": "UNLICENSED"
}
