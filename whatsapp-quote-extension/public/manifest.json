{
  "manifest_version": 3,
  "name": "MotoFlow Omni Beta",
  "description": "Extension multicanal beta de MotoFlow sobre WhatsApp Web.",
  "version": "2.0.0.1",
  "version_name": "2.0.0-beta.1",
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
