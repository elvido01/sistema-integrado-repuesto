{
  "manifest_version": 3,
  "name": "MotoFlow Omni Beta",
  "description": "Extension multicanal beta de MotoFlow: WhatsApp, Instagram y TikTok.",
  "version": "2.1.25.0",
  "version_name": "2.1.25-beta.1",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://www.instagram.com/*",
    "https://*.supabase.co/*",
    "https://www.tiktok.com/*",
    "https://motoflow.pages.dev/*",
    "https://*.motoflow.pages.dev/*",
    "https://repuestos-morla.pages.dev/*",
    "https://*.repuestos-morla.pages.dev/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "fondo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "jid-probe.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "ig-mirror.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "ig-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "tt-mirror.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "tt-protobuf.js",
        "tt-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://motoflow.pages.dev/*",
        "https://*.motoflow.pages.dev/*",
        "https://repuestos-morla.pages.dev/*",
        "https://*.repuestos-morla.pages.dev/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "motoflow-puente.js"
      ],
      "run_at": "document_start"
    }
  ]
}
